# ==============================================================================
# BARBER HEITOR — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=sua_chave_secreta_de_producao_aqui_obrigatória_se_debug_false
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,barberheitor.com.br,*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://barberheitor.com.br

# Banco de Dados (Padrão: SQLite local ou PostgreSQL em Produção)
# DATABASE_URL=postgres://usuario:senha@localhost:5432/barberheitor_db

# Configurações Oficiais da Marca — Barber Heitor
BARBER_NAME=Barber Heitor
BARBER_SHORT_NAME=Barber Heitor
BARBER_SLOGAN=Seu estilo. Sua assinatura.
BARBER_PHONE=(44) 9102-2176
BARBER_PHONE_RAW=554491022176
BARBER_EMAIL=contato@barberheitor.com.br
BARBER_INSTAGRAM=barberheitor_oficial
BARBER_ADDRESS=Rua Terezinha Fortes Martins, 136, Jardim Progresso, Paranavaí - PR
BARBER_HOURS=Seg a Sáb: 08:00 às 21:00

# Gateway de Pagamento & PIX (mock, mercadopago)
PAYMENT_GATEWAY=mock
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Dados do PIX
PIX_CHAVE=contato@barberheitor.com.br
PIX_TITULAR=Barber Heitor
PIX_CIDADE=Paranavai

# WhatsApp Provider (none, cloud_api, z-api, evolution)
WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# IA de Estilo & Visagismo (mock, openai, gemini)
AI_PROVIDER=mock
AI_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=contato@barberheitor.com.br
